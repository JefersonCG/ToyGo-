{
  "name": "toygo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ToyGo! hybrid playground management ecosystem with immutable ledger architecture.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:desktop": "npm --workspace @toygo/desktop run dev",
    "dev:central": "npm --workspace @toygo/central-web run dev",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
