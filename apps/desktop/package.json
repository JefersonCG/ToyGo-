{
  "name": "@toygo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ToyGo! Desktop operacional para parques indoor",
  "author": "Jeferson dos Santos Paula",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on dist-electron/main.js http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -b --pretty false",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/mariadb/prepare-embedded.ps1 && npm --workspace @toygo/installer run build && npm run build && electron-builder --config electron-builder.yml --win nsis"
  },
  "dependencies": {
    "@toygo/application": "0.1.0",
    "@toygo/backup": "0.1.0",
    "@toygo/database": "0.1.0",
    "@toygo/domain": "0.1.0",
    "@toygo/central-adapter": "0.1.0",
    "@toygo/installer": "0.1.0",
    "@toygo/ui-skins": "0.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  }
}
